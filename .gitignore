# Python
backend/.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Secrets. .env.example is committed, .env never is.
.env
backend/.env
frontend/.env.local

# Node
node_modules/
.next/
out/

# Local scratch
*.log
backend/.cache/
frontend/.playwright-shots/

# The owner's own reference material: 89 files, 12,8 MB across three sources -
# Whatsapp 63, Discord 18, Telegram 8 - being 82 annotated TradingView
# screenshots and 7 text files, of which two chat logs and `Discord/Buku=Pegangan.txt`
# carry the method in words. NOT tracked and deliberately so - it is his journal,
# not source - but it was not ignored either, so it sat in `git status` forever as
# untracked paths. Ignored here for two reasons, and the second is the
# load-bearing one:
#
#   1. `git status` becomes readable again.
#   2. `git clean -fd` cannot take it. It is cited by name in thirteen tracked
#      places - `app/projections.py` and `tests/test_projections.py` name
#      `Whatsapp/27.jpeg` as the provenance of a shipped sign convention - and
#      because it is not in git, deleting it is unrecoverable.
#
# RENAMED 26 AUGUST 2026, and the numbering survived the move: `27.jpeg` is still
# the Gold 15m chart of 2026-08-11 carrying two deviation stacks with the same six
# labels, verified by opening it rather than by trusting the name. The folder it
# used to live in, `analisis lama`, no longer exists on disk.
Referensi grup dan Bg Nas/

# Snapshot pengamatan lokal. Bukan cache: cache boleh dihapus kapan saja,
# snapshot yang terhapus adalah pengamatan yang hilang. Tidak pernah di-commit -
# isinya keadaan akun dan keputusan pribadi.
backend/.snapshots/

# Journal keputusan: satu baris per order, penolakan, fill, dan penutupan,
# lengkap dengan alasan dan ticket broker. Alasan yang sama dengan di atas, plus
# satu lagi: ia memuat nomor ticket akun sungguhan.
backend/.journal/

# Saklar auto-trade dan heartbeat daemon-nya. Keadaan trading sebuah akun, dan
# ia HARUS lokal: repo yang ter-commit dengan enabled=true akan menyalakan
# auto-trade di mesin siapa pun yang melakukan clone.
backend/.autotrade.json

# Endpoint AI Agent (base_url, api_key, model). Kredensial, dan aturan
# kredensial di grup ini mutlak sejak insiden 2026-05-28: tidak pernah
# ter-track, tidak pernah di-hardcode.
backend/.agent.json

# Referensi luar yang diunduh untuk analisis. Bukan sumber, dan bukan milik
# proyek ini - dua di antaranya PDF paper berhak cipta.
external_refs/
external_refs_analisis_lama/

# Stderr daemon auto-trade. `*.log` di atas sudah menutup stdout-nya; ini
# pasangannya, dan ia sama-sama keadaan runtime satu mesin.
backend/.autotrade.err

# Watermark monitor: sampai detik dan byte offset mana laporan terakhir sudah
# membaca. Keadaan lokal sebuah proses pengamat, bukan sumber. Ter-commit, ia
# akan membuat clone pertama melewatkan seluruh riwayat sebelum watermark itu.
backend/.monitor.json

# Artefak Playwright. Dihasilkan ulang tiap run, dan sebagian berisi screenshot
# chart akun sungguhan.
frontend/test-results/

# Keluaran `python -m tools.brief`. Snapshot hidup, bukan bukti pengukuran:
# ia berubah tiap run dan 3 MB per run akan mengotori diff. Berbeda dengan
# `docs/*.json`, yang memang di-commit karena satu satunya salinan angka yang
# sebuah dokumen mengutipnya. Di-anchor ke root: tanpa slash awal ia juga
# match ke backend/tools/brief, yaitu paket yang MENGHASILKANNYA.
#
# DAN SETIAP `--out` LAIN, karena aturan satu direktori tidak menutup apa pun.
# `brief-btc/` dan `brief-xau/` dibuat lewat `--out` dengan nama berbeda,
# lolos dari `/brief/`, dan ter-track. Sekali di-regenerate keduanya
# menghasilkan diff 1.141.704 baris, yaitu persis pengotoran yang aturan di
# atas ada untuk mencegahnya.
/brief/
/brief-*/

# Error logs, the .err sibling of *.log
*.err
backend/.autotrade.log.*

# Config Strategy Tester per sel, ditulis ulang tiap run oleh
# `backend/tools/mt5_backtest.py`. Isinya sepenuhnya ditentukan argumen tool
# itu, yang tercatat di kepala `docs/mt5-backtest.json`, dan input EA-nya
# tersimpan di `.set` yang IKUT di-commit bersama report-nya. Jadi yang
# diabaikan di sini adalah satu-satunya bagian yang bisa dihasilkan ulang.
mql5/ZonelabSupplyDemand/.run_*.ini

# Report HTML Strategy Tester. 120 file, 140,6 MB, dan yang menutup lubang
# reproducibility bukan file ini: `.set` di sebelahnya (30 KB total) merekam
# SETIAP input yang dipakai, dan `docs/mt5-backtest.json` plus
# `docs/mt5-walkforward.json` merekam angka tiap sel beserta baris `Inputs:`
# yang report itu sendiri catat. `tools.mt5_backtest` menghasilkan ulang HTML-nya
# dari `.set` yang sama. Yang dulu rusak adalah input yang tidak tercatat dan
# report yang saling menimpa, dan dua-duanya sudah ditutup tanpa 140 MB.
mql5/ZonelabSupplyDemand/reports/*.htm
