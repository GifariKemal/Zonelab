//@version=6
// Zonelab FVG Strategy - cermin `app/detect/imbalance.py:detect_fvg` plus
// geometri trade `app/plan.py:build`. Urutan lifecycle sudah benar di kedua
// sisi: SENTUH DICATAT SEBELUM PECAH.
//
// TARGET SEKARANG DARI ZONA LAWAN, cermin `app/profit_zone.py:profit_zone_at`,
// dan itu perubahan terpenting file ini. Sampai 7 September 2026 harness ini
// memakai target R TETAP sementara `execute.py` memakai zona lawan, jadi
// gerbang GAMBAR dan gerbang ORDER memvalidasi dua hal berbeda. Selisihnya
// bukan kosmetik dan sudah menggigit dua kali:
//
//   sel        harness R tetap    bracket produksi
//   XAU 30m    PF 0,833           PF 1,129, walk-forward 7 dari 8
//   BTC 1h     PF 0,882           PF 1,210, walk-forward 7 dari 8
//
// Dua sel TERBAIK di repo gagal di harness dan lolos di produksi. `target_mode`
// menyimpan keduanya supaya selisih itu bisa diukur lagi, bukan diperdebatkan.
//
// use_bar_magnifier WAJIB. Tanpa itu Strategy Tester menyelesaikan setiap bar
// yang memuat stop DAN target sebagai kalah. Terukur XAUUSD 30m tanpa gerbang:
// PF 0,9396 tanpa lawan 0,9568 dengan, pada 6.409 lawan 6.408 trade.
strategy("Zonelab FVG Strategy", overlay=true,
     pyramiding = 500,
     initial_capital = 10000000,
     default_qty_type = strategy.fixed,
     default_qty_value = 1,
     commission_type = strategy.commission.percent,
     commission_value = 0.0,
     process_orders_on_close = false,
     use_bar_magnifier = true,
     calc_on_every_tick = false)

atr_len       = input.int(14,    "atr_period",         group="Detector")
min_gap_atr   = input.float(0.0, "min_gap_atr",        group="Detector", step=0.05)
gate_ceiling  = input.float(0.25,"gate ceiling (ATR)", group="Detector", step=0.05)
filter_mother = input.bool(true, "filter_mother",      group="Detector")
min_body      = input.float(0.3, "min_body_ratio",     group="Detector", step=0.05)

// 1 = zona lawan (cermin produksi, default), 0 = R tetap (harness lama).
target_mode   = input.int(1, "target 1=zona lawan 0=R tetap", group="Trade",
     minval=0, maxval=1)
// Dipakai HANYA di mode 0. Frontier R tetap di XAUUSD 4h, 13,7 tahun dengan
// biaya: 1R win 54,56 PF 1,127 - 1,5R 47,54 / 1,177 - 2R 42,84 / 1,183 -
// 4R 38,53 / 1,266. Keempatnya profit; 1R dipilih karena kriterianya win rate.
reward_r      = input.float(1.0, "reward (R), mode 0",  group="Trade", step=0.5)
stop_buf_atr  = input.float(1.0, "stop buffer ATR",    group="Trade", step=0.05)
horizon       = input.int(80,    "horizon bars",       group="Trade")
risk_usd      = input.float(1000,"risk per trade USD", group="Trade")
max_pending   = input.int(80,    "max pending zones",  group="Trade")
// Berapa zona lawan yang diingat untuk dicari dindingnya. `profit_zone_at`
// memindai SELURUH daftar; di sini dibatasi karena pemindaian per kelahiran
// membuatnya kuadratik. Dinding terdekat hampir selalu zona yang baru, jadi
// batas ini pendekatan - dan ia DINYATAKAN, bukan disembunyikan. Terukur 7
// September 2026: 30 memberi PF 1,079, 300 memberi 1,091, dan 1000 memberi
// angka yang IDENTIK dengan 300, jadi batas ini sudah jenuh.
wall_memory   = input.int(300, "zona lawan yang diingat", group="Trade", minval=20)
cost_pct      = input.float(0.0113, "biaya % per sisi", group="Trade", step=0.001,
     tooltip = "XAU 0,0113 - BTC 0,01329, dari app/costs.py. TIDAK lewat commission_value karena Pine menuntut const di sana, dan TIDAK lewat dialog Strategy Properties karena dialog itu kembali ke nol setiap TradingView di-restart - run tanpa biaya lalu terbaca persis seperti run dengan biaya. Angka di tabel sudah bersih biaya; Strategy Tester bawaan tidak.")
placebo_atr   = input.float(0.0, "placebo shift ATR",  group="Control", step=0.5)
win_from      = input.time(timestamp("2000-01-01T00:00:00+0000"), "mulai",  group="Control")
win_to        = input.time(timestamp("2038-01-01T00:00:00+0000"), "sampai", group="Control")

// `ta.atr` adalah RMA Wilder, disemai dari bar pertama, jadi nilainya di satu
// bar bergantung berapa bar yang dimuat. Rata rata TR atas tepat `atr_len` suku
// sama di jendela mana pun. Cermin `app/indicators.py:mean_true_range`.
atr_v = ta.sma(ta.tr(true), atr_len)
in_win = time >= win_from and time <= win_to

// Order yang masih menunggu terisi.
var array<float> p_prox = array.new_float()
var array<float> p_dist = array.new_float()
var array<int>   p_dir  = array.new_int()
var array<string> p_id  = array.new_string()
var array<float> p_h    = array.new_float()
var array<float> p_stop = array.new_float()

// SETIAP zona yang pernah lahir dan belum pecah, sebagai calon dinding.
// Terpisah dari daftar pending: zona yang sudah terisi berhenti jadi order tapi
// TIDAK berhenti jadi dinding bagi zona lain.
var array<float> w_prox = array.new_float()
var array<float> w_dist = array.new_float()
var array<int>   w_dir  = array.new_int()

var int c_cand = 0
var int c_gate = 0
var int c_fill = 0
var int c_cancel = 0
var int c_evict = 0
var int c_nowall = 0
var int seen = 0
var int n_tr = 0
var int n_win = 0
var float sum_win = 0.0
var float sum_loss = 0.0
var float sum_rr = 0.0
var float sum_fee = 0.0

drop(int k) =>
    array.remove(p_prox, k)
    array.remove(p_dist, k)
    array.remove(p_dir,  k)
    array.remove(p_id,   k)
    array.remove(p_h,    k)
    array.remove(p_stop, k)

// Dinding yang harganya sudah tembus BUKAN dinding lagi - baris `state is
// BROKEN and time_to <= when` di `profit_zone_at`. Dibersihkan tiap bar SEBELUM
// zona baru mencari dindingnya, supaya yang ditemukan hanya yang hidup.
if array.size(w_prox) > 0
    for k = array.size(w_prox) - 1 to 0
        if (array.get(w_dir, k) == 1 ? close < array.get(w_dist, k) : close > array.get(w_dist, k))
            array.remove(w_prox, k)
            array.remove(w_dist, k)
            array.remove(w_dir,  k)

// SENTUH DIPERIKSA SEBELUM PECAH, sama dengan `replay_lifecycle`.
//
// TARGET DIPILIH DI SINI, saat order TERISI - bukan saat zona lahir. Itu yang
// `intrabar.resolved` lakukan: `profit_zone_at(zone, zones, time[touch])`.
// Bedanya bukan kosmetik. Limitnya bisa menunggu berhari-hari, dan dinding yang
// lahir selama penantian itu NYATA bagi pedagang yang baru terisi sekarang.
// Menghitungnya di kelahiran membuang dinding-dinding itu dan memberi target
// yang lebih jauh dari yang produksi pakai.
//
// TIDAK ADA REPAINT DI JALUR INI, dan itu diuji setelah target dipindah ke
// sini, bukan sebelumnya. Riwayat dipotong Bar Replay di 2025-06-02 lalu
// dimajukan sekitar dua hari bar: `gross_profit` tetap 868.416,778 sampai sen,
// `winning_trades` tetap 849, `largest_win` dan `largest_loss` tetap - yang
// berubah hanya satu trade baru yang tutup sebagai pecundang senilai 998,40.
// Kalau pemilihan target di sini mengintip masa depan, seluruh riwayat akan
// terhitung ulang.
if array.size(p_prox) > 0
    for k = array.size(p_prox) - 1 to 0
        dir  = array.get(p_dir,  k)
        dist = array.get(p_dist, k)
        prox = array.get(p_prox, k)
        filled = dir == 1 ? low <= prox  : high >= prox
        broken = dir == 1 ? close < dist : close > dist
        if filled
            c_fill += 1
            fid = array.get(p_id,   k)
            fh  = array.get(p_h,    k)
            fst = array.get(p_stop, k)
            frisk = math.abs(prox - fst)
            rr = 0.0
            if target_mode == 1
                best = 0.0
                if array.size(w_prox) > 0
                    for j = 0 to array.size(w_prox) - 1
                        if array.get(w_dir, j) != dir
                            gap = dir == 1 ? array.get(w_prox, j) - prox : prox - array.get(w_prox, j)
                            if gap > 0 and (best == 0.0 or gap < best)
                                best := gap
                rr := best > 0 and fh > 0 ? best / fh : 0.0
            if (target_mode == 0 or rr > 0) and frisk > 0
                targ = target_mode == 1 ? (dir == 1 ? prox + rr * fh : prox - rr * fh) : (dir == 1 ? prox + reward_r * frisk : prox - reward_r * frisk)
                sum_rr += target_mode == 1 ? rr * fh / frisk : reward_r
                strategy.exit("x" + fid, from_entry = fid, stop = fst, limit = targ)
            else
                // Produksi TIDAK mengambil trade ini - `plan.target` None dan
                // barisnya dilewati. Di sini posisinya sudah terlanjur terisi,
                // jadi ditutup segera dan dihitung terpisah.
                c_nowall += 1
                strategy.close(fid)
            drop(k)
        else if broken
            strategy.cancel(array.get(p_id, k))
            c_cancel += 1
            drop(k)

// Terukur DATAR dan knob ini tidak pernah mengikat: 20 bar memberi PF 1,088,
// 80 memberi 1,091, dan 300 juga 1,091. Trade selesai di stop atau target jauh
// sebelum 20 bar, jadi horizon di sini jaring pengaman, bukan parameter.
if strategy.opentrades > 0
    for t = strategy.opentrades - 1 to 0
        if bar_index - strategy.opentrades.entry_bar_index(t) >= horizon
            strategy.close(strategy.opentrades.entry_id(t))

if strategy.closedtrades > seen
    for i = seen to strategy.closedtrades - 1
        notional = strategy.closedtrades.entry_price(i) * math.abs(strategy.closedtrades.size(i))
        fee = 2.0 * notional * cost_pct / 100.0
        sum_fee += fee
        r = (strategy.closedtrades.profit(i) - fee) / risk_usd
        n_tr += 1
        if r > 0
            n_win += 1
            sum_win += r
        else
            sum_loss += -r
    seen := strategy.closedtrades

scale = atr_v[3]
bull  = high[2] < low[0]
bear  = low[2]  > high[0]

mother = high[1] >= high[2] and high[1] >= high[0] and low[1] <= low[2] and low[1] <= low[0]
mid_rng  = high[1] - low[1]
mid_body = math.abs(close[1] - open[1])
doji = min_body > 0 and mid_rng > 0 and mid_body / mid_rng < min_body

if (bull or bear) and not na(scale) and scale > 0 and not (filter_mother and mother) and not doji and in_win
    top0 = bull ? low[0]  : low[2]
    bot0 = bull ? high[2] : high[0]
    h    = top0 - bot0
    if h > 0
        c_cand += 1
        // Placebo digeser SEBELUM percabangan gerbang supaya dinding dan order
        // memakai koordinat yang sama. `calibrate.shift` menggeser SETIAP zona;
        // menggeser yang diperdagangkan saja diam-diam membandingkan kotak
        // palsu terhadap dinding asli.
        off  = placebo_atr == 0 ? 0.0 : placebo_atr * scale * (bar_index % 2 == 0 ? 1 : -1)
        top  = top0 + off
        bot  = bot0 + off
        prox = bull ? top : bot
        dist = bull ? bot : top

        // SETIAP zona jadi calon dinding, LOLOS GERBANG ATAU TIDAK. Produksi
        // memanggil `profit_zone_at(zone, zones, ...)` dengan `zones` = seluruh
        // keluaran detektor; gerbang keberangkatan baru menyaring BARIS HASIL,
        // jauh setelah target dipilih. Mendaftarkan hanya zona yang lolos
        // gerbang membuang dinding terdekat dan memberi target yang terlalu
        // jauh - persis arah kesalahan yang terukur (RR rata-rata 4,39).
        array.push(w_prox, prox)
        array.push(w_dist, dist)
        array.push(w_dir,  bull ? 1 : -1)
        if array.size(w_prox) > wall_memory
            array.remove(w_prox, 0)
            array.remove(w_dist, 0)
            array.remove(w_dir,  0)

        // AMBANG INI DIPERIKSA ULANG 7 September 2026 dan ia BERTAHAN, tapi
        // bukan di sel yang mungkin diduga. Di XAUUSD 4 jam mematikan gerbang
        // justru lebih baik (1,111 pada 4.156 trade lawan 1,091 pada 1.709), dan
        // kurvanya tidak monoton di sana - 0,10 memberi 1,013 lalu 0,15
        // melompat ke 1,169. Di 1 jam dan harian ia jelas membayar: 0,902 lawan
        // 1,006 dan 1,027 lawan 1,112. Dua dari tiga timeframe, jadi 4 jam yang
        // pengecualian.
        if h >= min_gap_atr * scale and (gate_ceiling <= 0 or h / scale < gate_ceiling)
            c_gate += 1
            stop = bull ? dist - stop_buf_atr * scale : dist + stop_buf_atr * scale
            risk = math.abs(prox - stop)
            // Stop DAN qty dikunci di sini karena `strategy.entry` mengunci qty
            // saat order dipasang. Produksi memakai ATR di bar SENTUHAN
            // (`scale_at="touch"`), yang belum ada saat limit ini dipasang,
            // jadi harness ini setara `scale_at="birth"` - bandingkan ke sana,
            // bukan ke default produksi. Sumbu itu diukur terpisah dan hampir
            // tidak bergerak: XAU 30m 1,126 lawan 1,138, BTC 1h 1,207 lawan
            // 1,256.
            if risk > 0
                qty = risk_usd / risk
                id  = "z" + str.tostring(bar_index)
                strategy.entry(id, bull ? strategy.long : strategy.short, qty = qty, limit = prox)
                // Stop aktif sejak detik pertama; limitnya menyusul saat
                // terisi, waktu dindingnya baru bisa dipilih.
                strategy.exit("x" + id, from_entry = id, stop = stop)
                array.push(p_prox, prox)
                array.push(p_dist, dist)
                array.push(p_dir,  bull ? 1 : -1)
                array.push(p_id,   id)
                array.push(p_h,    h)
                array.push(p_stop, stop)
                if array.size(p_prox) > max_pending
                    strategy.cancel(array.get(p_id, 0))
                    c_evict += 1
                    drop(0)

var int first_t = na
if barstate.isfirst
    first_t := time
// `barstate.islast` SENDIRIAN SALAH di sini dan compiler mengatakannya di setiap
// kompilasi: dengan `calc_on_every_tick = false` script hanya jalan di bar yang
// sudah tutup, jadi di bar realtime yang belum tutup `islast` tidak pernah
// menyala dan tabelnya TIDAK ADA - sampai 30 menit sekali di 30m. Terbaca
// seperti script yang rusak, padahal cuma menunggu lilin.
//
// TAPI `islastconfirmedhistory` SENDIRIAN MEMBEKUKAN TABEL DI BAR REPLAY, dan
// itu terukur: dipotong di 2025-06-02 lalu dimajukan tiga bar, `bars` tetap
// 20.698 dan `span` tetap berakhir 2025-05-30. Replay menambah bar sebagai
// realtime, bukan sebagai riwayat terkonfirmasi, jadi predikat itu menyala
// sekali di titik potong dan tidak pernah lagi. Angka yang identik sesudah
// melangkah lalu terbaca sebagai "tidak ada repaint" padahal tabelnya cuma
// tidak menghitung ulang - test yang hampa dan terlihat seperti test yang lolos.
//
// Keduanya digabung dengan `or`, yang hanya bisa MENAMBAH bar tempat tabel
// digambar dan tidak pernah mengurangi, jadi ia tidak bisa menghidupkan lagi
// cacat pertama. Diverifikasi: dipotong di 2025-06-02 lalu dimajukan, `bars`
// bergerak 20.698 ke 20.705 dan `span` ikut maju - sebelumnya keduanya beku.
if barstate.islastconfirmedhistory or barstate.islast
    var table t = table.new(position.top_right, 2, 13, border_width=1)
    table.cell(t, 0, 0, "cfg",   bgcolor=color.new(color.gray, 80), text_size=size.small)
    table.cell(t, 1, 0, syminfo.ticker + " " + timeframe.period +
         " a" + str.tostring(atr_len) + " g" + str.tostring(gate_ceiling) +
         (target_mode == 1 ? " Twall" : " R" + str.tostring(reward_r)) +
         " s" + str.tostring(stop_buf_atr) +
         (filter_mother ? " M" : "") + (min_body > 0 ? " B" + str.tostring(min_body) : "") +
         " p" + str.tostring(placebo_atr) + " c" + str.tostring(cost_pct), text_size=size.small)
    table.cell(t, 0, 1, "span",  bgcolor=color.new(color.gray, 80), text_size=size.small)
    table.cell(t, 1, 1, str.format_time(first_t, "yyyy-MM-dd", "UTC") + " " +
         str.format_time(time, "yyyy-MM-dd", "UTC"), text_size=size.small)
    table.cell(t, 0, 2, "bars",  bgcolor=color.new(color.gray, 80), text_size=size.small)
    table.cell(t, 1, 2, str.tostring(bar_index + 1), text_size=size.small)
    table.cell(t, 0, 3, "cand",  bgcolor=color.new(color.gray, 80), text_size=size.small)
    table.cell(t, 1, 3, str.tostring(c_cand), text_size=size.small)
    table.cell(t, 0, 4, "gate",  bgcolor=color.new(color.gray, 80), text_size=size.small)
    table.cell(t, 1, 4, str.tostring(c_gate), text_size=size.small)
    table.cell(t, 0, 5, "no wall", bgcolor=color.new(color.gray, 80), text_size=size.small)
    table.cell(t, 1, 5, str.tostring(c_nowall), text_size=size.small)
    table.cell(t, 0, 6, "fill",  bgcolor=color.new(color.gray, 80), text_size=size.small)
    table.cell(t, 1, 6, str.tostring(c_fill), text_size=size.small)
    table.cell(t, 0, 7, "canc/ev", bgcolor=color.new(color.gray, 80), text_size=size.small)
    table.cell(t, 1, 7, str.tostring(c_cancel) + "/" + str.tostring(c_evict), text_size=size.small)
    table.cell(t, 0, 8, "n",     bgcolor=color.new(color.gray, 80), text_size=size.small)
    table.cell(t, 1, 8, str.tostring(n_tr), text_size=size.small)
    table.cell(t, 0, 9, "win%",  bgcolor=color.new(color.gray, 80), text_size=size.small)
    table.cell(t, 1, 9, str.tostring(100.0 * n_win / math.max(n_tr, 1), "#.##"), text_size=size.small)
    table.cell(t, 0, 10, "PF",   bgcolor=color.new(color.gray, 80), text_size=size.small)
    table.cell(t, 1, 10, str.tostring(sum_win / math.max(sum_loss, 0.000001), "#.###"), text_size=size.small)
    table.cell(t, 0, 11, "biaya (R)", bgcolor=color.new(color.gray, 80), text_size=size.small)
    table.cell(t, 1, 11, str.tostring(sum_fee / risk_usd / math.max(n_tr, 1), "#.####") +
         " x" + str.tostring(n_tr), text_size=size.small)
    table.cell(t, 0, 12, "exp_r / RR", bgcolor=color.new(color.gray, 80), text_size=size.small)
    table.cell(t, 1, 12, str.tostring((sum_win - sum_loss) / math.max(n_tr, 1), "#.####") +
         " / " + str.tostring(sum_rr / math.max(c_gate - c_nowall, 1), "#.##"), text_size=size.small)
