# Copy to backend/.env and fill in. Every value is optional: with no .env at
# all the app runs on Binance PAXG/USDT, which needs no key.

# binance | yahoo | twelvedata | polygon | synthetic
ZONELAB_DEFAULT_PROVIDER=binance

# True spot XAU/USD. Free tier: 800 requests/day. https://twelvedata.com
ZONELAB_TWELVEDATA_KEY=

# True spot via Massive, formerly Polygon.io. Free tier: 5 requests/minute.
ZONELAB_POLYGON_KEY=


ZONELAB_CACHE_TTL_SECONDS=20

# The language model, used ONLY to phrase measurements and to LOOK at charts -
# never to decide. Ten pre-registered directional hypotheses failed in this
# project, so a model that volunteered a buy or a sell would be inventing.
#
# The ban is enforced rather than requested: every reply passes a grounding
# check that rejects any number not present in the data the model was given.
# It cannot smuggle a price target past that, because a target is a number.
#
# Leave empty and the feature refuses and explains itself. Everything the
# engine measures works without it.
ZONELAB_LLM_KEY=
ZONELAB_LLM_MODEL=glm-5.3
ZONELAB_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
