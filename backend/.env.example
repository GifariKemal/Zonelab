# Copy to backend/.env and fill in. Every value is optional: with no .env at
# all the app runs on the local MetaTrader 5 terminal where there is one, and
# falls back to Binance PAXG/USDT - which needs no key - where there is not.

# mt5 | binance | dukascopy | yahoo | twelvedata | polygon | synthetic
#
# A VALUE HERE BEATS THE CODE DEFAULT SILENTLY. That is the point of the file,
# but it is also how the app came up on binance for a day while `config.py` said
# mt5: nothing reports the override, so an unexpected source on the picker is
# worth checking here first.
#
# mt5 reads the terminal already running on this machine - no key, no network,
# no rate limit, and the broker's own prices with a real spread. It probes as
# unavailable when the terminal is closed, and the UI then falls through to the
# next source that carries the symbol.
ZONELAB_DEFAULT_PROVIDER=mt5

# True spot XAU/USD. Free tier: 800 requests/day. https://twelvedata.com
ZONELAB_TWELVEDATA_KEY=

# True spot via Massive, formerly Polygon.io. Free tier: 5 requests/minute.
ZONELAB_POLYGON_KEY=


ZONELAB_CACHE_TTL_SECONDS=20

# The language model, used ONLY to phrase measurements and to LOOK at charts -
# never to decide. Ten pre-registered directional hypotheses failed in this
# project, so a model that volunteered a buy or a sell would be inventing.
#
# The ban is enforced rather than requested: every reply passes a grounding
# check that rejects any number not present in the data the model was given.
# It cannot smuggle a price target past that, because a target is a number.
#
# Leave empty and the feature refuses and explains itself. Everything the
# engine measures works without it.
ZONELAB_LLM_KEY=
ZONELAB_LLM_MODEL=glm-5.3
ZONELAB_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ---------------------------------------------------------------------------
# Delapan setting di bawah dibaca `app/config.py` dan tidak pernah muncul di
# file ini, jadi operator yang menyalin contoh ini apa adanya tidak tahu ia
# punya knob-nya. Nilai yang tertulis adalah DEFAULT-nya: menghapus barisnya
# memberi hasil yang sama, jadi ia dokumentasi dan bukan konfigurasi wajib.
# Dua yang paling layak diketahui ada di bawah - `MAX_BARS` menentukan ceiling
# chart, `CORS_ORIGIN_REGEX` menentukan origin browser yang diizinkan.

# Ceiling jumlah bar yang boleh diminta satu request.
# ZONELAB_MAX_BARS=50000

# Origin yang diizinkan CORS. Longgarkan ini dan API bisa dipanggil dari
# halaman lain di mesin yang sama.
# ZONELAB_CORS_ORIGIN_REGEX=http://(localhost|127\.0\.0\.1)(:\d+)?

# Timeout satu panggilan HTTP ke vendor, dalam detik.
# ZONELAB_HTTP_TIMEOUT_SECONDS=15.0

# Jalur model bahasa: `http` untuk endpoint OpenAI-compatible, `cli` untuk
# jembatan Claude Code lokal.
# ZONELAB_LLM_BACKEND=http

# Timeout jalur HTTP-nya, dalam detik.
# ZONELAB_LLM_TIMEOUT_SECONDS=60.0

# Command yang dijalankan kalau backend-nya `cli`, plus timeout-nya.
# ZONELAB_LLM_CLI_COMMAND=claude
# ZONELAB_LLM_CLI_TIMEOUT_SECONDS=300.0

# Plafon panjang prompt untuk jalur one-shot. Chat AI Agent punya plafonnya
# sendiri di `app/agent.py` dan TIDAK memakai angka ini.
# ZONELAB_LLM_MAX_PROMPT_CHARS=40000
